//@version=6
indicator("Mean Reversion T", overlay = true, max_labels_count = 500)


// ============================================================================
// Mean Reversion T · 9分版
// 推荐周期：15分钟
//
// 双引擎：
//
// 1. Range Reversion
//    市场本身适合震荡回归
//    → 较温和的 Z 偏离即可寻找 T
//
// 2. Shock Reversal
//    市场不一定完美横盘
//    → 但必须出现异常冲击
//    → 同时出现减速 / 拒绝
//    → 再等待回归确认
//
// 共同保护：
// Hard Trend Veto
//
// 生命周期：
// 观察 → T买/T空 → T减 → T平
//
// 异常退出：
// T止损 / 趋势失效 / T超时 / T保本
//
// 本脚本仅为 indicator。
// 不自动交易。
// ============================================================================


// ============================================================================
// ① 交易方向
// ============================================================================

allowLong = input.bool(true, "允许 T买", group = "① 交易方向")
allowShort = input.bool(true, "允许 T空", group = "① 交易方向")


// ============================================================================
// ② Local Mean / Z-score
// ============================================================================

meanLen = input.int(32, "15m 局部均值 EMA", minval = 10, group = "② 均值与Z-score")
zLen = input.int(32, "Z-score 周期", minval = 10, group = "② 均值与Z-score")

rangeEntryZ = input.float(1.65, "Range模式观察 Z", minval = 1.0, step = 0.05, group = "② 均值与Z-score")
shockEntryZ = input.float(2.00, "Shock模式观察 Z", minval = 1.2, step = 0.05, group = "② 均值与Z-score")

rangePartialZ = input.float(0.80, "Range T减目标 Z", minval = 0.10, step = 0.05, group = "② 均值与Z-score")
rangeExitZ = input.float(0.25, "Range T平目标 Z", minval = 0.0, step = 0.05, group = "② 均值与Z-score")

shockPartialZ = input.float(1.00, "Shock T减目标 Z", minval = 0.10, step = 0.05, group = "② 均值与Z-score")
shockExitZ = input.float(0.50, "Shock T平目标 Z", minval = 0.0, step = 0.05, group = "② 均值与Z-score")

stopZ = input.float(3.25, "极端统计失效 Z", minval = 2.2, step = 0.25, group = "② 均值与Z-score")


// ============================================================================
// ③ 1H 市场状态
// ============================================================================

htfTf = input.timeframe("60", "市场状态周期", group = "③ 1H 市场状态")
htfMeanLen = input.int(20, "1H 均值 EMA", minval = 5, group = "③ 1H 市场状态")
htfSlopeLookback = input.int(4, "1H 斜率周期", minval = 1, group = "③ 1H 市场状态")

idealHtfSlope = input.float(0.10, "1H 理想最大斜率 ATR/Bar", minval = 0.01, step = 0.01, group = "③ 1H 市场状态")

htfERLen = input.int(10, "1H Efficiency Ratio 周期", minval = 3, group = "③ 1H 市场状态")
idealHtfER = input.float(0.50, "1H 理想最大 ER", minval = 0.10, maxval = 1.0, step = 0.05, group = "③ 1H 市场状态")


// ============================================================================
// ④ 15m 市场状态
// ============================================================================

localSlopeLookback = input.int(8, "15m 斜率周期", minval = 2, group = "④ 15m 市场状态")
idealLocalSlope = input.float(0.12, "15m 理想最大斜率 ATR/Bar", minval = 0.01, step = 0.01, group = "④ 15m 市场状态")

localERLen = input.int(16, "15m Efficiency Ratio 周期", minval = 3, group = "④ 15m 市场状态")
idealLocalER = input.float(0.60, "15m 理想最大 ER", minval = 0.10, maxval = 1.0, step = 0.05, group = "④ 15m 市场状态")


// ============================================================================
// ⑤ Regime Score
// ============================================================================

rangeMinScore = input.float(50.0, "Range模式最低环境分", minval = 0, maxval = 100, step = 1, group = "⑤ Regime Score")
shockMinScore = input.float(45.0, "Shock模式最低环境分", minval = 0, maxval = 100, step = 1, group = "⑤ Regime Score")

regimeSmoothLen = input.int(3, "环境分平滑周期", minval = 1, maxval = 8, group = "⑤ Regime Score")


// ============================================================================
// ⑥ Hard Trend Veto
// ============================================================================
//
// 比上一版稍微敏感。
// ============================================================================

vetoHtfSlope = input.float(0.18, "1H 趋势禁做斜率", minval = 0.05, step = 0.01, group = "⑥ Hard Trend Veto")
vetoLocalSlope = input.float(0.23, "15m 趋势禁做斜率", minval = 0.05, step = 0.01, group = "⑥ Hard Trend Veto")

vetoHtfER = input.float(0.75, "1H 趋势禁做 ER", minval = 0.50, maxval = 1.0, step = 0.01, group = "⑥ Hard Trend Veto")
vetoLocalER = input.float(0.80, "15m 趋势禁做 ER", minval = 0.50, maxval = 1.0, step = 0.01, group = "⑥ Hard Trend Veto")


// ============================================================================
// ⑦ Shock Engine
// ============================================================================

shockLookback = input.int(2, "Shock 检测 K 数", minval = 1, maxval = 4, group = "⑦ Shock Engine")
minShockATR = input.float(0.80, "最小 Shock 强度 ATR", minval = 0.20, step = 0.05, group = "⑦ Shock Engine")

requireShockDeceleration = input.bool(true, "Shock要求冲击减速", group = "⑦ Shock Engine")
decelerationRatio = input.float(0.85, "Shock减速比例", minval = 0.30, maxval = 1.20, step = 0.05, group = "⑦ Shock Engine")

requireRejection = input.bool(true, "Shock要求拒绝/反向K线", group = "⑦ Shock Engine")

minWickRatio = input.float(0.30, "最低拒绝影线比例", minval = 0.0, maxval = 0.8, step = 0.05, group = "⑦ Shock Engine")


// ============================================================================
// ⑧ Half-Life / Time Stop
// ============================================================================

halfLifeLookback = input.int(80, "Half-Life 样本长度", minval = 30, group = "⑧ Half-Life")

timeStopMultiplier = input.float(3.0, "Time Stop = Half-Life ×", minval = 1.0, step = 0.25, group = "⑧ Half-Life")

minTimeStopBars = input.int(8, "最短 Time Stop", minval = 2, group = "⑧ Half-Life")
maxTimeStopBars = input.int(40, "最长 Time Stop", minval = 8, group = "⑧ Half-Life")
fallbackTimeStopBars = input.int(24, "Half-Life无效时 Time Stop", minval = 4, group = "⑧ Half-Life")


// ============================================================================
// ⑨ Setup / Confirmation
// ============================================================================

rangeSetupBars = input.int(16, "Range Setup 有效 K 数", minval = 2, maxval = 48, group = "⑨ 入场确认")
shockSetupBars = input.int(8, "Shock Setup 有效 K 数", minval = 2, maxval = 24, group = "⑨ 入场确认")

requireCandleConfirm = input.bool(true, "要求K线方向确认", group = "⑨ 入场确认")
requireBandReclaim = input.bool(true, "要求价格重新进入Z区间", group = "⑨ 入场确认")

cooldownBars = input.int(3, "退出后冷却 K 数", minval = 0, maxval = 24, group = "⑨ 入场确认")


// ============================================================================
// ⑩ 风险控制
// ============================================================================

atrLen = input.int(14, "ATR 周期", minval = 1, group = "⑩ 风险控制")

hardStopATR = input.float(2.50, "ATR 紧急止损", minval = 0.50, step = 0.25, group = "⑩ 风险控制")

stopMode = input.string("Balanced", "止损模式", options = ["Tight", "Balanced", "Loose"], group = "⑩ 风险控制")

balancedWeight = input.float(0.50, "Balanced统计止损权重", minval = 0.0, maxval = 1.0, step = 0.05, group = "⑩ 风险控制")

moveStopToBE = input.bool(true, "T减后启用保本保护", group = "⑩ 风险控制")


// ============================================================================
// ⑪ 显示
// ============================================================================

showBands = input.bool(true, "显示均值回归区间", group = "⑪ 显示")
showBackground = input.bool(true, "显示做T环境", group = "⑪ 显示")
showSetup = input.bool(true, "显示观察信号", group = "⑪ 显示")
showPanel = input.bool(true, "显示状态面板", group = "⑪ 显示")
showTradeLevels = input.bool(true, "显示本轮目标/风险", group = "⑪ 显示")


// ============================================================================
// 参数检查
// ============================================================================

if shockEntryZ <= rangeEntryZ
    runtime.error("Shock模式 Z 必须高于 Range模式 Z。")

if rangeExitZ >= rangePartialZ
    runtime.error("Range T平目标必须小于 Range T减目标。")

if shockExitZ >= shockPartialZ
    runtime.error("Shock T平目标必须小于 Shock T减目标。")

if rangePartialZ >= rangeEntryZ
    runtime.error("Range T减目标必须小于 Range观察 Z。")

if shockPartialZ >= shockEntryZ
    runtime.error("Shock T减目标必须小于 Shock观察 Z。")

if stopZ <= shockEntryZ
    runtime.error("Stop Z 必须高于 Shock Entry Z。")


// ============================================================================
// 周期保护
// ============================================================================

chartSeconds = timeframe.in_seconds(timeframe.period)
requiredSeconds = timeframe.in_seconds("15")
htfSeconds = timeframe.in_seconds(htfTf)

if chartSeconds != requiredSeconds
    runtime.error("Mean Reversion T 设计用于15分钟图。")

if htfSeconds <= chartSeconds
    runtime.error("高周期必须高于15分钟，默认使用60分钟。")


// ============================================================================
// Helper Functions
// ============================================================================

f_er(int length) =>
    float absMove = math.abs(ta.change(close))
    float avgMove = ta.sma(absMove, length)
    float path = avgMove * length
    float net = math.abs(close - close[length])
    float result = path > 0.0 ? net / path : 0.0
    result


f_prevER(int length) =>
    float absMove = math.abs(ta.change(close))
    float avgMove = ta.sma(absMove, length)
    float path = avgMove * length
    float net = math.abs(close - close[length])
    float currentER = path > 0.0 ? net / path : 0.0
    float result = currentER[1]
    result


f_prevSlopeATR(int emaLength, int atrLength, int lookback) =>
    float m = ta.ema(close, emaLength)
    float a = math.max(ta.atr(atrLength), syminfo.mintick)
    float currentSlope = (m - m[lookback]) / a / lookback
    float result = currentSlope[1]
    result


f_score(float value, float idealLimit) =>
    float ratio = idealLimit > 0.0 ? math.abs(value) / idealLimit : 10.0
    float rawScore = 25.0 * (1.0 - ratio)
    float floorScore = math.max(rawScore, 0.0)
    float result = math.min(floorScore, 25.0)
    result


// ============================================================================
// Mean / ATR
// ============================================================================

mean15 = ta.ema(close, meanLen)
atr15 = ta.atr(atrLen)
safeATR = math.max(atr15, syminfo.mintick)


// ============================================================================
// Residual / Z-score
// ============================================================================

residual = close - mean15
residualStd = ta.stdev(residual, zLen)
safeStd = math.max(nz(residualStd), syminfo.mintick)
z = residual / safeStd


// ============================================================================
// 动态区间
// ============================================================================

upperRangeBand = mean15 + rangeEntryZ * safeStd
lowerRangeBand = mean15 - rangeEntryZ * safeStd

upperShockBand = mean15 + shockEntryZ * safeStd
lowerShockBand = mean15 - shockEntryZ * safeStd

upperStopBand = mean15 + stopZ * safeStd
lowerStopBand = mean15 - stopZ * safeStd


// ============================================================================
// Local Regime
// ============================================================================

localSlopeATR = (mean15 - mean15[localSlopeLookback]) / safeATR / localSlopeLookback
localER = f_er(localERLen)


// ============================================================================
// Confirmed 1H
// ============================================================================

htfSlopeATR = request.security(syminfo.tickerid, htfTf, f_prevSlopeATR(htfMeanLen, atrLen, htfSlopeLookback), lookahead = barmerge.lookahead_on)
htfER = request.security(syminfo.tickerid, htfTf, f_prevER(htfERLen), lookahead = barmerge.lookahead_on)


// ============================================================================
// Regime Score
// ============================================================================

htfSlopeScore = f_score(htfSlopeATR, idealHtfSlope)
htfERScore = f_score(htfER, idealHtfER)
localSlopeScore = f_score(localSlopeATR, idealLocalSlope)
localERScore = f_score(localER, idealLocalER)

rawRegimeScore = htfSlopeScore + htfERScore + localSlopeScore + localERScore
regimeScore = ta.sma(rawRegimeScore, regimeSmoothLen)


// ============================================================================
// Hard Trend Veto
// ============================================================================

htfSlopeVeto = math.abs(htfSlopeATR) >= vetoHtfSlope
localSlopeVeto = math.abs(localSlopeATR) >= vetoLocalSlope
htfERVeto = htfER >= vetoHtfER
localERVeto = localER >= vetoLocalER

hardTrendVeto = htfSlopeVeto or localSlopeVeto or htfERVeto or localERVeto

rangeEnvironment = not hardTrendVeto and regimeScore >= rangeMinScore
shockEnvironment = not hardTrendVeto and regimeScore >= shockMinScore


// ============================================================================
// Shock Detection
// ============================================================================
//
// Shock强度：最近N根走了多少ATR。
// ============================================================================

shockMove = (close - close[shockLookback]) / safeATR
shockUp = shockMove >= minShockATR
shockDown = shockMove <= -minShockATR


// ============================================================================
// Shock Deceleration
// ============================================================================
//
// 比较：
// 最近一段冲击
// VS
// 更前面一段冲击
//
// 当前冲击开始减弱 → 更像过冲结束。
// ============================================================================

previousShockMove = (close[shockLookback] - close[shockLookback * 2]) / safeATR

longShockDecelerating = math.abs(shockMove) <= math.abs(previousShockMove) * decelerationRatio
shortShockDecelerating = math.abs(shockMove) <= math.abs(previousShockMove) * decelerationRatio

longDecelerationOK = not requireShockDeceleration or longShockDecelerating
shortDecelerationOK = not requireShockDeceleration or shortShockDecelerating


// ============================================================================
// Candle / Wick Rejection
// ============================================================================

barRange = math.max(high - low, syminfo.mintick)

lowerWick = math.min(open, close) - low
upperWick = high - math.max(open, close)

lowerWickRatio = lowerWick / barRange
upperWickRatio = upperWick / barRange

bullishCandle = close > open
bearishCandle = close < open

longRejection = bullishCandle or lowerWickRatio >= minWickRatio
shortRejection = bearishCandle or upperWickRatio >= minWickRatio

longRejectionOK = not requireRejection or longRejection
shortRejectionOK = not requireRejection or shortRejection


// ============================================================================
// Half-Life
// ============================================================================

residualLag = residual[1]
residualDelta = residual - residual[1]

hlCorr = ta.correlation(residualDelta, residualLag, halfLifeLookback)
hlDeltaStd = ta.stdev(residualDelta, halfLifeLookback)
hlLagStd = ta.stdev(residualLag, halfLifeLookback)

bool betaOK = not na(hlCorr) and not na(hlDeltaStd) and not na(hlLagStd) and hlLagStd > 0.0

float hlBeta = na

if betaOK
    hlBeta := hlCorr * hlDeltaStd / hlLagStd

float halfLife = na

if not na(hlBeta) and hlBeta < -0.000001
    halfLife := -math.log(2.0) / hlBeta


// ============================================================================
// 全局 Cross
// ============================================================================

zCrossOverNegRange = ta.crossover(z, -rangeEntryZ)
zCrossUnderPosRange = ta.crossunder(z, rangeEntryZ)

zCrossOverNegShock = ta.crossover(z, -shockEntryZ)
zCrossUnderPosShock = ta.crossunder(z, shockEntryZ)


// ============================================================================
// Virtual State
// ============================================================================
//
// 0 = Flat
// 1 = Long
// -1 = Short
//
// SetupMode:
// 0 = None
// 1 = Range
// 2 = Shock
// ============================================================================

var int virtualPosition = 0

var int longSetupMode = 0
var int shortSetupMode = 0

var int longSetupBar = na
var int shortSetupBar = na

var bool partialTaken = false
var int lastExitBar = na


// ============================================================================
// Frozen Trade Data
// ============================================================================

var float tradeEntryPrice = na
var float tradeMean = na
var float tradeStd = na
var float tradeATR = na

var float tradePartialTarget = na
var float tradeFinalTarget = na
var float tradeBaseStop = na

var int tradeEntryBar = na
var int tradeTimeStop = na

var string tradeMode = ""


// ============================================================================
// Events
// ============================================================================

bool longRangeSetupEvent = false
bool shortRangeSetupEvent = false

bool longShockSetupEvent = false
bool shortShockSetupEvent = false

bool longEntryEvent = false
bool shortEntryEvent = false

bool longPartialEvent = false
bool shortPartialEvent = false

bool longCloseEvent = false
bool shortCloseEvent = false

bool longStopEvent = false
bool shortStopEvent = false

bool longTrendExitEvent = false
bool shortTrendExitEvent = false

bool longTimeEvent = false
bool shortTimeEvent = false

bool longBEEvent = false
bool shortBEEvent = false


// ============================================================================
// Cooldown
// ============================================================================

int barsSinceExit = 100000

if not na(lastExitBar)
    barsSinceExit := bar_index - lastExitBar

requiredCooldown = math.max(cooldownBars, 1)
canEnter = na(lastExitBar) or barsSinceExit >= requiredCooldown


// ============================================================================
// 创建 Setup
// ============================================================================
//
// Shock优先于Range。
// ============================================================================

if barstate.isconfirmed and virtualPosition == 0 and canEnter

    bool longShockSetup = allowLong and shockEnvironment and shockDown and z <= -shockEntryZ and longDecelerationOK and longRejectionOK and na(longSetupBar)
    bool shortShockSetup = allowShort and shockEnvironment and shockUp and z >= shockEntryZ and shortDecelerationOK and shortRejectionOK and na(shortSetupBar)

    bool longRangeSetup = allowLong and rangeEnvironment and z <= -rangeEntryZ and na(longSetupBar)
    bool shortRangeSetup = allowShort and rangeEnvironment and z >= rangeEntryZ and na(shortSetupBar)

    if longShockSetup
        longSetupBar := bar_index
        longSetupMode := 2
        shortSetupBar := na
        shortSetupMode := 0
        longShockSetupEvent := true

    else if shortShockSetup
        shortSetupBar := bar_index
        shortSetupMode := 2
        longSetupBar := na
        longSetupMode := 0
        shortShockSetupEvent := true

    else if longRangeSetup
        longSetupBar := bar_index
        longSetupMode := 1
        shortSetupBar := na
        shortSetupMode := 0
        longRangeSetupEvent := true

    else if shortRangeSetup
        shortSetupBar := bar_index
        shortSetupMode := 1
        longSetupBar := na
        longSetupMode := 0
        shortRangeSetupEvent := true


// ============================================================================
// Setup Expiry
// ============================================================================

if not na(longSetupBar)
    int longSetupAge = bar_index - longSetupBar
    int longAllowedAge = longSetupMode == 2 ? shockSetupBars : rangeSetupBars

    if longSetupAge > longAllowedAge
        longSetupBar := na
        longSetupMode := 0


if not na(shortSetupBar)
    int shortSetupAge = bar_index - shortSetupBar
    int shortAllowedAge = shortSetupMode == 2 ? shockSetupBars : rangeSetupBars

    if shortSetupAge > shortAllowedAge
        shortSetupBar := na
        shortSetupMode := 0


// ============================================================================
// Setup提前失败
// ============================================================================

if not na(longSetupBar) and z <= -stopZ
    longSetupBar := na
    longSetupMode := 0


if not na(shortSetupBar) and z >= stopZ
    shortSetupBar := na
    shortSetupMode := 0


// ============================================================================
// Entry Confirmation
// ============================================================================

longCandleOK = not requireCandleConfirm or close > close[1]
shortCandleOK = not requireCandleConfirm or close < close[1]

longZReclaim = longSetupMode == 2 ? zCrossOverNegShock : zCrossOverNegRange
shortZReclaim = shortSetupMode == 2 ? zCrossUnderPosShock : zCrossUnderPosRange

longBandReclaim = longSetupMode == 2 ? close > lowerShockBand : close > lowerRangeBand
shortBandReclaim = shortSetupMode == 2 ? close < upperShockBand : close < upperRangeBand

longBandOK = not requireBandReclaim or longBandReclaim
shortBandOK = not requireBandReclaim or shortBandReclaim

longEntrySignal = barstate.isconfirmed and virtualPosition == 0 and not hardTrendVeto and not na(longSetupBar) and longZReclaim and longBandOK and longCandleOK
shortEntrySignal = barstate.isconfirmed and virtualPosition == 0 and not hardTrendVeto and not na(shortSetupBar) and shortZReclaim and shortBandOK and shortCandleOK


// ============================================================================
// ENTER LONG
// ============================================================================

if longEntrySignal

    longEntryEvent := true
    virtualPosition := 1
    partialTaken := false

    tradeEntryPrice := close
    tradeMean := mean15
    tradeStd := safeStd
    tradeATR := safeATR
    tradeEntryBar := bar_index

    bool isShockTrade = longSetupMode == 2

    tradeMode := isShockTrade ? "Shock" : "Range"

    float selectedPartialZ = isShockTrade ? shockPartialZ : rangePartialZ
    float selectedExitZ = isShockTrade ? shockExitZ : rangeExitZ

    tradePartialTarget := tradeMean - selectedPartialZ * tradeStd
    tradeFinalTarget := tradeMean - selectedExitZ * tradeStd

    float atrStop = tradeEntryPrice - hardStopATR * tradeATR
    float statisticalStop = tradeMean - stopZ * tradeStd
    float tightStop = math.max(atrStop, statisticalStop)
    float looseStop = math.min(atrStop, statisticalStop)
    float balancedStop = looseStop + (tightStop - looseStop) * balancedWeight

    if stopMode == "Tight"
        tradeBaseStop := tightStop

    else if stopMode == "Loose"
        tradeBaseStop := looseStop

    else
        tradeBaseStop := balancedStop

    float rawTimeStop = fallbackTimeStopBars

    if not na(halfLife)
        rawTimeStop := halfLife * timeStopMultiplier

    float limitedTimeStop = math.max(minTimeStopBars, rawTimeStop)
    limitedTimeStop := math.min(maxTimeStopBars, limitedTimeStop)

    tradeTimeStop := int(math.round(limitedTimeStop))

    longSetupBar := na
    shortSetupBar := na

    longSetupMode := 0
    shortSetupMode := 0


// ============================================================================
// ENTER SHORT
// ============================================================================

else if shortEntrySignal

    shortEntryEvent := true
    virtualPosition := -1
    partialTaken := false

    tradeEntryPrice := close
    tradeMean := mean15
    tradeStd := safeStd
    tradeATR := safeATR
    tradeEntryBar := bar_index

    bool isShockTrade = shortSetupMode == 2

    tradeMode := isShockTrade ? "Shock" : "Range"

    float selectedPartialZ = isShockTrade ? shockPartialZ : rangePartialZ
    float selectedExitZ = isShockTrade ? shockExitZ : rangeExitZ

    tradePartialTarget := tradeMean + selectedPartialZ * tradeStd
    tradeFinalTarget := tradeMean + selectedExitZ * tradeStd

    float atrStop = tradeEntryPrice + hardStopATR * tradeATR
    float statisticalStop = tradeMean + stopZ * tradeStd
    float tightStop = math.min(atrStop, statisticalStop)
    float looseStop = math.max(atrStop, statisticalStop)
    float balancedStop = looseStop - (looseStop - tightStop) * balancedWeight

    if stopMode == "Tight"
        tradeBaseStop := tightStop

    else if stopMode == "Loose"
        tradeBaseStop := looseStop

    else
        tradeBaseStop := balancedStop

    float rawTimeStop = fallbackTimeStopBars

    if not na(halfLife)
        rawTimeStop := halfLife * timeStopMultiplier

    float limitedTimeStop = math.max(minTimeStopBars, rawTimeStop)
    limitedTimeStop := math.min(maxTimeStopBars, limitedTimeStop)

    tradeTimeStop := int(math.round(limitedTimeStop))

    longSetupBar := na
    shortSetupBar := na

    longSetupMode := 0
    shortSetupMode := 0


// ============================================================================
// Bars Held
// ============================================================================

int barsHeld = 0

if not na(tradeEntryBar)
    barsHeld := bar_index - tradeEntryBar


// ============================================================================
// Active Stop
// ============================================================================

float activeStop = na

if virtualPosition == 1
    activeStop := tradeBaseStop

    if moveStopToBE and partialTaken
        activeStop := math.max(tradeBaseStop, tradeEntryPrice)


if virtualPosition == -1
    activeStop := tradeBaseStop

    if moveStopToBE and partialTaken
        activeStop := math.min(tradeBaseStop, tradeEntryPrice)


// ============================================================================
// Directional Trend Failure
// ============================================================================

longTrendFailure = htfSlopeATR <= -vetoHtfSlope or localSlopeATR <= -vetoLocalSlope
shortTrendFailure = htfSlopeATR >= vetoHtfSlope or localSlopeATR >= vetoLocalSlope


// ============================================================================
// Manage Long
// ============================================================================

canManageLong = virtualPosition == 1 and not na(tradeEntryBar) and bar_index > tradeEntryBar

if barstate.isconfirmed and canManageLong

    bool stopHit = not na(activeStop) and close <= activeStop
    bool trendFailed = longTrendFailure
    bool timeFailed = not na(tradeTimeStop) and barsHeld >= tradeTimeStop
    bool finalReached = not na(tradeFinalTarget) and close >= tradeFinalTarget
    bool partialReached = not partialTaken and not na(tradePartialTarget) and close >= tradePartialTarget

    if stopHit

        bool isBE = partialTaken and moveStopToBE and activeStop >= tradeEntryPrice

        if isBE
            longBEEvent := true
        else
            longStopEvent := true

        virtualPosition := 0
        partialTaken := false
        lastExitBar := bar_index

    else if trendFailed

        longTrendExitEvent := true
        virtualPosition := 0
        partialTaken := false
        lastExitBar := bar_index

    else if timeFailed

        longTimeEvent := true
        virtualPosition := 0
        partialTaken := false
        lastExitBar := bar_index

    else if finalReached

        longCloseEvent := true
        virtualPosition := 0
        partialTaken := false
        lastExitBar := bar_index

    else if partialReached

        longPartialEvent := true
        partialTaken := true


// ============================================================================
// Manage Short
// ============================================================================

canManageShort = virtualPosition == -1 and not na(tradeEntryBar) and bar_index > tradeEntryBar

if barstate.isconfirmed and canManageShort

    bool stopHit = not na(activeStop) and close >= activeStop
    bool trendFailed = shortTrendFailure
    bool timeFailed = not na(tradeTimeStop) and barsHeld >= tradeTimeStop
    bool finalReached = not na(tradeFinalTarget) and close <= tradeFinalTarget
    bool partialReached = not partialTaken and not na(tradePartialTarget) and close <= tradePartialTarget

    if stopHit

        bool isBE = partialTaken and moveStopToBE and activeStop <= tradeEntryPrice

        if isBE
            shortBEEvent := true
        else
            shortStopEvent := true

        virtualPosition := 0
        partialTaken := false
        lastExitBar := bar_index

    else if trendFailed

        shortTrendExitEvent := true
        virtualPosition := 0
        partialTaken := false
        lastExitBar := bar_index

    else if timeFailed

        shortTimeEvent := true
        virtualPosition := 0
        partialTaken := false
        lastExitBar := bar_index

    else if finalReached

        shortCloseEvent := true
        virtualPosition := 0
        partialTaken := false
        lastExitBar := bar_index

    else if partialReached

        shortPartialEvent := true
        partialTaken := true


// ============================================================================
// Trade Reset
// ============================================================================

tradeEnded = longCloseEvent or shortCloseEvent or longStopEvent or shortStopEvent or longTrendExitEvent or shortTrendExitEvent or longTimeEvent or shortTimeEvent or longBEEvent or shortBEEvent

if tradeEnded
    tradeEntryPrice := na
    tradeMean := na
    tradeStd := na
    tradeATR := na
    tradePartialTarget := na
    tradeFinalTarget := na
    tradeBaseStop := na
    tradeEntryBar := na
    tradeTimeStop := na
    tradeMode := ""
    longSetupBar := na
    shortSetupBar := na
    longSetupMode := 0
    shortSetupMode := 0


// ============================================================================
// Plot Mean
// ============================================================================

plot(mean15, "Local Mean", color = color.yellow, linewidth = 2)


// ============================================================================
// Bands
// ============================================================================

pRangeUpper = plot(showBands ? upperRangeBand : na, "Range +Z", color = color.new(color.orange, 35))
pRangeLower = plot(showBands ? lowerRangeBand : na, "Range -Z", color = color.new(color.aqua, 35))

pShockUpper = plot(showBands ? upperShockBand : na, "Shock +Z", color = color.new(color.red, 35))
pShockLower = plot(showBands ? lowerShockBand : na, "Shock -Z", color = color.new(color.green, 35))

pStopUpper = plot(showBands ? upperStopBand : na, "Extreme +Z", color = color.new(color.red, 75))
pStopLower = plot(showBands ? lowerStopBand : na, "Extreme -Z", color = color.new(color.red, 75))

fill(pShockUpper, pStopUpper, color = showBands ? color.new(color.red, 94) : na)
fill(pShockLower, pStopLower, color = showBands ? color.new(color.green, 94) : na)


// ============================================================================
// Background
// ============================================================================

color bgCol = na

if showBackground
    if rangeEnvironment
        bgCol := color.new(color.blue, 92)
    else if shockEnvironment
        bgCol := color.new(color.purple, 94)

bgcolor(bgCol, title = "Mean Reversion Environment")


// ============================================================================
// Active Trade Lines
// ============================================================================

float activePartialLine = na
float activeFinalLine = na
float activeRiskLine = na

if virtualPosition != 0
    activePartialLine := tradePartialTarget
    activeFinalLine := tradeFinalTarget
    activeRiskLine := activeStop

plot(showTradeLevels ? activePartialLine : na, "T减目标", color = color.orange, linewidth = 2, style = plot.style_linebr)
plot(showTradeLevels ? activeFinalLine : na, "T平目标", color = color.white, linewidth = 2, style = plot.style_linebr)
plot(showTradeLevels ? activeRiskLine : na, "风险线", color = color.red, linewidth = 2, style = plot.style_linebr)


// ============================================================================
// Setup Labels
// ============================================================================

plotshape(showSetup and longRangeSetupEvent, title = "Range T买观察", text = "R观察", style = shape.labelup, location = location.belowbar, color = color.new(color.green, 55), textcolor = color.white, size = size.tiny)
plotshape(showSetup and shortRangeSetupEvent, title = "Range T空观察", text = "R观察", style = shape.labeldown, location = location.abovebar, color = color.new(color.red, 55), textcolor = color.white, size = size.tiny)

plotshape(showSetup and longShockSetupEvent, title = "Shock T买观察", text = "S观察", style = shape.labelup, location = location.belowbar, color = color.green, textcolor = color.white, size = size.tiny)
plotshape(showSetup and shortShockSetupEvent, title = "Shock T空观察", text = "S观察", style = shape.labeldown, location = location.abovebar, color = color.red, textcolor = color.white, size = size.tiny)


// ============================================================================
// Entry
// ============================================================================

plotshape(longEntryEvent, title = "T买", text = "T买", style = shape.labelup, location = location.belowbar, color = color.green, textcolor = color.white, size = size.small)
plotshape(shortEntryEvent, title = "T空", text = "T空", style = shape.labeldown, location = location.abovebar, color = color.red, textcolor = color.white, size = size.small)


// ============================================================================
// Partial
// ============================================================================

plotshape(longPartialEvent, title = "T多减", text = "T减", style = shape.labeldown, location = location.abovebar, color = color.orange, textcolor = color.white, size = size.tiny)
plotshape(shortPartialEvent, title = "T空减", text = "T减", style = shape.labelup, location = location.belowbar, color = color.aqua, textcolor = color.black, size = size.tiny)


// ============================================================================
// Normal Close
// ============================================================================

plotshape(longCloseEvent, title = "T多平", text = "T平", style = shape.labeldown, location = location.abovebar, color = color.lime, textcolor = color.black, size = size.small)
plotshape(shortCloseEvent, title = "T空平", text = "T平", style = shape.labelup, location = location.belowbar, color = color.lime, textcolor = color.black, size = size.small)


// ============================================================================
// Stop / Failure
// ============================================================================

plotshape(longStopEvent, title = "T多止损", text = "T止损", style = shape.labeldown, location = location.abovebar, color = color.red, textcolor = color.white, size = size.small)
plotshape(shortStopEvent, title = "T空止损", text = "T止损", style = shape.labelup, location = location.belowbar, color = color.red, textcolor = color.white, size = size.small)

plotshape(longTrendExitEvent, title = "T多趋势失效", text = "趋势失效", style = shape.labeldown, location = location.abovebar, color = color.purple, textcolor = color.white, size = size.small)
plotshape(shortTrendExitEvent, title = "T空趋势失效", text = "趋势失效", style = shape.labelup, location = location.belowbar, color = color.purple, textcolor = color.white, size = size.small)

plotshape(longTimeEvent, title = "T多超时", text = "T超时", style = shape.labeldown, location = location.abovebar, color = color.gray, textcolor = color.white, size = size.small)
plotshape(shortTimeEvent, title = "T空超时", text = "T超时", style = shape.labelup, location = location.belowbar, color = color.gray, textcolor = color.white, size = size.small)

plotshape(longBEEvent, title = "T多保本", text = "T保本", style = shape.labeldown, location = location.abovebar, color = color.gray, textcolor = color.white, size = size.tiny)
plotshape(shortBEEvent, title = "T空保本", text = "T保本", style = shape.labelup, location = location.belowbar, color = color.gray, textcolor = color.white, size = size.tiny)


// ============================================================================
// Data Window
// ============================================================================

plot(z, "Z-score", display = display.data_window)
plot(regimeScore, "Regime Score", display = display.data_window)
plot(halfLife, "Half-Life", display = display.data_window)
plot(shockMove, "Shock ATR", display = display.data_window)
plot(previousShockMove, "Previous Shock ATR", display = display.data_window)
plot(localER, "15m ER", display = display.data_window)
plot(htfER, "1H ER", display = display.data_window)
plot(localSlopeATR, "15m Slope", display = display.data_window)
plot(htfSlopeATR, "1H Slope", display = display.data_window)


// ============================================================================
// Panel
// ============================================================================

var table panel = table.new(position.top_right, 2, 10, border_width = 1)

if showPanel and barstate.islast

    string envText = "禁做T"
    color envColor = color.gray

    if rangeEnvironment
        envText := "Range"
        envColor := color.aqua
    else if shockEnvironment
        envText := "Shock Only"
        envColor := color.purple

    string stateText = virtualPosition == 1 ? "T多" : virtualPosition == -1 ? "T空" : "空仓"

    string setupText = "无"

    if longSetupMode == 1
        setupText := "R等T买"
    else if longSetupMode == 2
        setupText := "S等T买"
    else if shortSetupMode == 1
        setupText := "R等T空"
    else if shortSetupMode == 2
        setupText := "S等T空"

    string hlText = na(halfLife) ? "无效" : str.tostring(halfLife, "#.0")
    string shockText = str.tostring(shockMove, "#.00") + " ATR"
    string scoreText = str.tostring(regimeScore, "#")
    string modeText = virtualPosition == 0 ? "-" : tradeMode
    string stopText = stopMode

    table.cell(panel, 0, 0, "MR-T")
    table.cell(panel, 1, 0, "9分版")

    table.cell(panel, 0, 1, "环境")
    table.cell(panel, 1, 1, envText, text_color = envColor)

    table.cell(panel, 0, 2, "Score")
    table.cell(panel, 1, 2, scoreText)

    table.cell(panel, 0, 3, "状态")
    table.cell(panel, 1, 3, stateText)

    table.cell(panel, 0, 4, "Setup")
    table.cell(panel, 1, 4, setupText)

    table.cell(panel, 0, 5, "Z")
    table.cell(panel, 1, 5, str.tostring(z, "#.00"))

    table.cell(panel, 0, 6, "Shock")
    table.cell(panel, 1, 6, shockText)

    table.cell(panel, 0, 7, "Half-Life")
    table.cell(panel, 1, 7, hlText)

    table.cell(panel, 0, 8, "模式")
    table.cell(panel, 1, 8, modeText)

    table.cell(panel, 0, 9, "Stop")
    table.cell(panel, 1, 9, stopText)


if not showPanel and barstate.islast
    table.clear(panel, 0, 0, 1, 9)


// ============================================================================
// Alerts
// ============================================================================

alertcondition(longRangeSetupEvent or shortRangeSetupEvent, "MR-T Range观察", "Mean Reversion T：Range模式出现均值偏离")
alertcondition(longShockSetupEvent or shortShockSetupEvent, "MR-T Shock观察", "Mean Reversion T：出现异常价格冲击并开始减速")
alertcondition(longEntryEvent, "MR-T T买", "Mean Reversion T：出现T买确认")
alertcondition(shortEntryEvent, "MR-T T空", "Mean Reversion T：出现T空确认")
alertcondition(longPartialEvent or shortPartialEvent, "MR-T T减", "Mean Reversion T：完成第一阶段回归")
alertcondition(longCloseEvent or shortCloseEvent, "MR-T T平", "Mean Reversion T：主要均值回归完成")
alertcondition(longStopEvent or shortStopEvent, "MR-T T止损", "Mean Reversion T：触发风险线")
alertcondition(longTrendExitEvent or shortTrendExitEvent, "MR-T 趋势失效", "Mean Reversion T：市场已经发展为趋势环境")
alertcondition(longTimeEvent or shortTimeEvent, "MR-T T超时", "Mean Reversion T：均值回归时间超过预期")
alertcondition(longBEEvent or shortBEEvent, "MR-T T保本", "Mean Reversion T：第一目标后触发保本保护")